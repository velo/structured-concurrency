{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "maven-wrapper"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pom\\.xml$/"],
      "matchStrings": ["<openjdk\\.ref>(?<currentValue>[^<]+)</openjdk\\.ref>"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "openjdk/jdk",
      "versioningTemplate": "regex:^jdk-(?<major>28)\\+(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pom\\.xml$/"],
      "matchStrings": ["<jdk28\\.image>(?<depName>openjdk):(?<currentValue>[^<]+)</jdk28\\.image>"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>28)-ea-(?<patch>\\d+)-jdk$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["maven-wrapper"],
      "matchDepNames": ["maven"],
      "allowedVersions": "<3.10.0"
    },
    {
      "matchDepNames": ["openjdk/jdk", "openjdk"],
      "groupName": "OpenJDK early-access build"
    }
  ]
}
