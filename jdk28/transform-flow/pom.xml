<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.marvinformatics.structured</groupId>
    <artifactId>jdk28</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>transform-flow</artifactId>
  <name>JDK 28 Bytecode Transform Flow</name>
  <description>Runs the backport test classes, retargeted to java.util.concurrent by Eclipse Transformer, on the JDK</description>

  <dependencies>
    <dependency>
      <groupId>com.marvinformatics.structured</groupId>
      <artifactId>structured-concurrency</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-transformer-rules</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.marvinformatics.structured</groupId>
                  <artifactId>structured-concurrency-transformer-rules</artifactId>
                  <version>${project.version}</version>
                </artifactItem>
              </artifactItems>
              <includes>**/*.properties</includes>
              <outputDirectory>${project.build.directory}/transformer-rules</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>unpack-backport-tests</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeGroupIds>com.marvinformatics.structured</includeGroupIds>
              <includeArtifactIds>structured-concurrency</includeArtifactIds>
              <includeTypes>test-jar</includeTypes>
              <excludes>META-INF/**</excludes>
              <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.transformer</groupId>
        <artifactId>transformer-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>retarget-to-jdk</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>transform</goal>
            </goals>
            <configuration>
              <transformDirectory>${project.build.testOutputDirectory}</transformDirectory>
              <rules>
                <renames>
                  <rename>${project.build.directory}/transformer-rules/com/marvinformatics/structured/transformer/backport-to-jdk-package-renames.properties</rename>
                </renames>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <classpathDependencyExcludes>
            <classpathDependencyExclude>com.marvinformatics.structured:structured-concurrency</classpathDependencyExclude>
          </classpathDependencyExcludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
