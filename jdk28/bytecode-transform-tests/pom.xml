<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.marvinformatics.structured</groupId>
    <artifactId>jdk28</artifactId>
    <version>0.1.1-SNAPSHOT</version>
  </parent>

  <artifactId>bytecode-transform-tests</artifactId>
  <name>JDK 28 Bytecode Transform Tests</name>
  <description>Runs the backport test classes, retargeted to java.util.concurrent by Eclipse Transformer, on the JDK</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-backport-tests-and-transformer-rules</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.marvinformatics.structured</groupId>
                  <artifactId>structured-concurrency-transformer-rules</artifactId>
                  <version>${project.version}</version>
                  <includes>**/*.properties</includes>
                  <outputDirectory>${project.build.directory}/transformer-rules</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>com.marvinformatics.structured</groupId>
                  <artifactId>structured-concurrency</artifactId>
                  <version>${project.version}</version>
                  <classifier>tests</classifier>
                  <excludes>META-INF/**</excludes>
                  <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.transformer</groupId>
        <artifactId>transformer-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>transform-to-jdk</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>transform</goal>
            </goals>
            <configuration>
              <transformDirectory>${project.build.testOutputDirectory}</transformDirectory>
              <rules>
                <renames>
                  <rename>${project.build.directory}/transformer-rules/com/marvinformatics/structured/transformer/backport-to-jdk-package-renames.properties</rename>
                </renames>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
