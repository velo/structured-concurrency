<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.marvinformatics.structured</groupId>
    <artifactId>structured-concurrency-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>structured-concurrency-upstream-conformance</artifactId>
  <name>Structured Concurrency Upstream Conformance</name>

  <properties>
    <upstream.tests.url>https://raw.githubusercontent.com/openjdk/jdk/${openjdk.ref}/test/jdk/java/util/concurrent/StructuredTaskScope</upstream.tests.url>
    <upstream.tests.dir>${project.build.directory}/upstream-tests/${openjdk.ref}</upstream.tests.dir>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.marvinformatics.structured</groupId>
      <artifactId>structured-concurrency</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>fetch-and-repackage-upstream-tests</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${upstream.tests.dir}"/>
                <get dest="${upstream.tests.dir}" skipexisting="true">
                  <url url="${upstream.tests.url}/StructuredTaskScopeTest.java"/>
                  <url url="${upstream.tests.url}/StressCancellation.java"/>
                </get>
                <replaceregexp flags="g">
                  <regexp pattern="java\.util\.concurrent\.(StructuredTaskScope|StructureViolationException)"/>
                  <substitution expression="com.marvinformatics.structured.\1"/>
                  <fileset dir="${upstream.tests.dir}" includes="*.java"/>
                </replaceregexp>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-upstream-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${upstream.tests.dir}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>*.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
